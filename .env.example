# =============================================================================
# OSGB Platform - environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# All secrets below are DEVELOPMENT placeholders - rotate them for production.
# =============================================================================

# ----- General ---------------------------------------------------------------
NODE_ENV=development
APP_NAME=osgb-platform
# Public URL of the platform (used for links in e-mails, CORS defaults, viewer URLs)
APP_URL=http://localhost:8080

# ----- Ports -----------------------------------------------------------------
WEB_PORT=5173
API_PORT=3000
NGINX_HTTP_PORT=8080

# ----- API -------------------------------------------------------------------
API_PREFIX=api
LOG_LEVEL=debug
# Log every SQL statement at debug level (query text only, never parameters). Development only.
LOG_SQL=false
# Include /health probes in the access log
LOG_HEALTH_REQUESTS=false
# Pretty console logs for local development (JSON logs are always used in production)
LOG_PRETTY=true
# Comma separated list of allowed origins. Use the exact scheme+host+port.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Max JSON / form body size accepted by the API
REQUEST_BODY_LIMIT=1mb
# Rate limiting: <limit> requests per <ttl> seconds per IP
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
# Set to true when running behind Nginx / a load balancer (uses X-Forwarded-* headers)
TRUST_PROXY=true
# Swagger UI is only enabled when true (default: enabled outside production)
SWAGGER_ENABLED=true

# ----- PostgreSQL (application) ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=osgb
POSTGRES_USER=osgb
POSTGRES_PASSWORD=osgb_dev_password
# Prisma connection string (inside Docker the host is `postgres`)
DATABASE_URL=postgresql://osgb:osgb_dev_password@localhost:5432/osgb?schema=public

# ----- PostgreSQL (Orthanc index - separate database & user) -----------------
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=orthanc_dev_password

# ----- Redis / BullMQ --------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ----- JWT -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=osgb-platform

# ----- MinIO (object storage) ------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=osgb-minio
MINIO_SECRET_KEY=osgb-minio-dev-secret
MINIO_BUCKET=osgb-documents
MINIO_REGION=us-east-1
# Console port is only exposed in docker-compose.dev.yml
MINIO_CONSOLE_PORT=9001

# ----- Orthanc (PACS) --------------------------------------------------------
# The API talks to Orthanc over the internal Docker network. Never expose these
# credentials to the browser; the frontend reaches DICOMweb only through Nginx.
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc_dev_password
# base64("ORTHANC_USERNAME:ORTHANC_PASSWORD") - used by Nginx to authenticate the
# /dicom-web proxy against Orthanc. Regenerate with: ./scripts/orthanc-basic-auth.sh
ORTHANC_BASIC_AUTH_B64=b3J0aGFuYzpvcnRoYW5jX2Rldl9wYXNzd29yZA==
# Orthanc AE title for DICOM (port 4242, internal only by default)
ORTHANC_AET=OSGB
# DICOM C-STORE/MWL listener. Bind a dedicated LAN/VPN address in production, never 0.0.0.0.
ORTHANC_DICOM_BIND=127.0.0.1
ORTHANC_DICOM_PORT=4242
# Register each modality by exact AE Title and IP. This example may send images but cannot browse PACS.
ORTHANC_DICOM_MODALITIES_JSON={"xray01":{"AET":"XRAY01","Host":"192.0.2.10","Port":104,"AllowEcho":true,"AllowFind":true,"AllowMove":false,"AllowGet":false,"AllowStore":true}}

# ----- Identity: ID card OCR + official verification ------------------------
# OCR (tesseract.js) reads the machine-readable zone (MRZ) of Turkish ID cards.
# Language data is downloaded once into OCR_CACHE_PATH (needs outbound internet on first use).
OCR_ENABLED=true
# Primary model: bundled MRZ/OCR-B model (apps/api/tessdata). Fallback downloads from the tesseract.js CDN.
OCR_LANGUAGES=mrz
OCR_FALLBACK_LANGUAGES=eng
# OCR_LANG_PATH=/repo/apps/api/tessdata
# OCR_CACHE_PATH=/var/lib/osgb/tessdata
# Official verification of TC Kimlik No + name + birth year: none | nvi (NVİ KPS public SOAP service)
IDENTITY_VERIFICATION_PROVIDER=none
NVI_KPS_URL=https://tckimlik.nvi.gov.tr/Service/KPSPublic.asmx
NVI_KPS_TIMEOUT_MS=8000

# ----- OHIF Viewer -----------------------------------------------------------
# Public path where Nginx serves OHIF; the API builds viewer links from this.
OHIF_VIEWER_PATH=/viewer

# ----- Seed data (development only) ------------------------------------------
SEED_TENANT_NAME=Demo OSGB
SEED_TENANT_SLUG=demo
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=Admin123!

# ----- Web (Vite) - only VITE_* variables are exposed to the browser ---------
VITE_API_BASE_URL=/api
VITE_APP_NAME=OSGB Platform
VITE_OHIF_VIEWER_PATH=/viewer
# ID card OCR location: hybrid (browser first, API fallback) | client | server
VITE_ID_SCAN_MODE=hybrid
