{
  "name": "@osgb/api",
  "version": "0.1.0",
  "private": true,
  "description": "OSGB platform API (NestJS modular monolith)",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "prisma generate && node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.config.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:seed": "prisma db seed",
    "prisma:seed:reset": "SEED_WIPE=true tsx prisma/seed.ts",
    "prisma:seed:locations": "tsx prisma/seed-locations.ts",
    "prisma:studio": "prisma studio",
    "clean": "rm -rf dist coverage src/generated"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@osgb/shared-types": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dejavu-fonts-ttf": "2.37.3",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "nestjs-pino": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@osgb/eslint-config": "workspace:*",
    "@osgb/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "bwip-js": "^4.11.4",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
