// -----------------------------------------------------------------------------
// OSGB Platform - main application schema (Prisma 7)
//
// Conventions
//  - Every business entity carries `tenantId`; tenant isolation is enforced in
//    the repository layer (see src/common/tenancy) - never trusted from clients.
//  - UUIDs for all primary keys.
//  - Soft delete via `deletedAt` where records must remain for audit/legal reasons.
//  - Orthanc/DICOM binaries are NEVER stored here; only references (study ids).
//  - Non-DICOM files live in MinIO; `Document` stores bucket/objectKey references.
// -----------------------------------------------------------------------------

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------- Enums -----------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

/// Turkish OHS law (6331) hazard classes.
enum HazardClass {
  LESS_HAZARDOUS
  HAZARDOUS
  VERY_HAZARDOUS
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
}

enum IdentityVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
  /// Confirmed by staff against the physical document (no electronic source).
  MANUAL
}

enum ExaminationType {
  PRE_EMPLOYMENT
  PERIODIC
  RETURN_TO_WORK
  EXIT
  SPECIAL
}

enum PhysicianStatus {
  ACTIVE
  INACTIVE
}

enum ConsentType {
  DISCLOSURE
  EXPLICIT_CONSENT
  HEALTH_DATA
  COMMUNICATION
}

enum ConsentStatus {
  GIVEN
  WITHDRAWN
}

enum ConsentMethod {
  PAPER
  SIGNATURE_PAD
  ELECTRONIC
  VERBAL
}

enum ProtocolStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProtocolItemType {
  RADIOLOGY
  AUDIOMETRY
  ECG
  SPIROMETRY
  EYE
  PNEUMOCONIOSIS
  LAB
  HEALTH_REPORT
  ISG_REPORT
}

enum TestCategory {
  RADIOLOGY
  AUDIOMETRY
  ECG
  SPIROMETRY
  EYE
  PNEUMOCONIOSIS
  LAB
  HEALTH_REPORT
  ISG_REPORT
  OTHER
}

enum ProtocolItemStatus {
  PENDING
  DONE
  CANCELLED
}

enum ExaminationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

enum FitnessDecision {
  PENDING
  FIT
  FIT_WITH_RESTRICTIONS
  UNFIT
}

enum RadiologyModality {
  CR
  DX
  CT
  MR
  US
  OT
}

enum RadiologyRequestStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REPORTED
  CANCELLED
}

enum AppointmentType {
  EXAMINATION
  RADIOLOGY
  TRAINING
  CONSULTATION
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentCategory {
  REPORT
  CERTIFICATE
  SCANNED_DOCUMENT
  SIGNED_FORM
  ECG_TRACE
  SPIROMETRY_TRACE
  ATTACHMENT
  OTHER
}

// ----------------------------- Tenancy & IAM ---------------------------------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  /// URL/identifier friendly unique key, e.g. "acme-osgb".
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  settings  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  users                   User[]
  roles                   Role[]
  userRoles               UserRole[]
  refreshSessions         RefreshSession[]
  companies               Company[]
  branches                Branch[]
  workplaces              Workplace[]
  employees               Employee[]
  protocols               Protocol[]
  physicians              Physician[]
  testDefinitions         TestDefinition[]
  testPackages            TestPackage[]
  occupations             Occupation[]
  consentTemplates        ConsentTemplate[]
  patientConsents         PatientConsent[]
  documentSignatures      DocumentSignature[]
  examinationMeasurements ExaminationMeasurement[]
  audiometryTests         AudiometryTest[]
  ecgRecords              EcgRecord[]
  spirometryTests         SpirometryTest[]
  eyeExaminations         EyeExamination[]
  pneumoconiosisReadings  PneumoconiosisReading[]
  profile                 OrganizationProfile?
  examinations            Examination[]
  radiologyRequests       RadiologyRequest[]
  documents               Document[]
  appointments            Appointment[]
  auditLogs               AuditLog[]
  operationRecords        OperationRecord[]
  notifications           Notification[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  companyId    String?    @db.Uuid
  company      Company?   @relation("CompanyUsers", fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  passwordResetTokens PasswordResetToken[]
  userRoles       UserRole[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  operationRecords       OperationRecord[]
  physicianProfile       Physician?
  collectedConsents      PatientConsent[]         @relation("ConsentCollector")
  collectedSignatures    DocumentSignature[]      @relation("SignatureCollector")
  recordedMeasurements   ExaminationMeasurement[] @relation("MeasurementRecorder")
  performedAudiometry    AudiometryTest[]         @relation("AudiometryPerformer")
  performedEcg           EcgRecord[]              @relation("EcgPerformer")
  performedSpirometry    SpirometryTest[]         @relation("SpirometryPerformer")
  performedEye           EyeExamination[]         @relation("EyePerformer")
  pneumoconiosisReadings PneumoconiosisReading[]  @relation("PneumoReader")
  openedProtocols        Protocol[]               @relation("ProtocolOpener")
  closedProtocols        Protocol[]               @relation("ProtocolCloser")
  performedExaminations  Examination[]            @relation("ExaminationPhysician")
  approvedExaminations   Examination[]            @relation("ExaminationApprover")
  uploadedDocuments      Document[]               @relation("DocumentUploader")
  createdAppointments    Appointment[]            @relation("AppointmentCreator")

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  /// System roles are created by the seed and cannot be deleted by tenant admins.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

/// Global permission catalogue (not tenant scoped). Seeded from @osgb/shared-types.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  category    String
  description String
  /// Grants access to sensitive occupational-health data.
  isMedical   Boolean  @default(false)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Refresh token session. Only a SHA-256 hash of the token is stored.
model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set when the session was rotated; used for refresh-token reuse detection.
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_sessions")
}

// ----------------------------- Customers -------------------------------------

/// A client company served by the OSGB.
model Company {
  id                    String      @id @default(uuid()) @db.Uuid
  tenantId              String      @db.Uuid
  name                  String
  taxNumber             String?
  sgkRegistrationNumber String?
  hazardClass           HazardClass @default(LESS_HAZARDOUS)
  address               String?
  phone                 String?
  email                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branches     Branch[]
  workplaces   Workplace[]
  employees    Employee[]
  protocols    Protocol[]
  documents    Document[]
  appointments Appointment[]
  users        User[] @relation("CompanyUsers")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("companies")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  companyId String    @db.Uuid
  name      String
  address   String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  workplaces Workplace[]
  employees  Employee[]

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@map("branches")
}

/// A physical workplace (işyeri) registered under a company/branch.
model Workplace {
  id                    String      @id @default(uuid()) @db.Uuid
  tenantId              String      @db.Uuid
  companyId             String      @db.Uuid
  branchId              String?     @db.Uuid
  name                  String
  sgkRegistrationNumber String?
  hazardClass           HazardClass @default(LESS_HAZARDOUS)
  naceCode              String?
  address               String?
  employeeCount         Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])
  employees Employee[]

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@map("workplaces")
}

model Employee {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  /// Optional at registration; the workplace can be assigned later (Hasta Kayıt → Düzenle).
  companyId             String?        @db.Uuid
  branchId              String?        @db.Uuid
  workplaceId           String?        @db.Uuid
  /// National identity number (TC Kimlik No). Personal data - handle with care.
  nationalId            String?
  /// Employer/registry number (Sicil No).
  registrationNumber    String?
  passportNumber        String?
  firstName             String
  lastName              String
  birthDate             DateTime?      @db.Date
  gender                Gender?
  motherName            String?
  fatherName            String?
  /// Mobile (GSM), 10 digits without country code.
  phone                 String?
  /// Landline (Ev Tel), 10 digits.
  homePhone             String?
  email                 String?
  addressProvinceId     Int?
  addressDistrictId     Int?
  addressNeighborhoodId Int?
  addressLine           String?
  /// Free-text warning / note shown on the patient card (Uyarı/Açıklama).
  notes                 String?
  /// Free-text job title kept for legacy rows; the catalogue link is preferred.
  jobTitle              String?
  occupationId          String?        @db.Uuid
  department            String?
  hireDate              DateTime?      @db.Date
  status                EmployeeStatus @default(ACTIVE)

  identityVerificationStatus IdentityVerificationStatus @default(UNVERIFIED)
  identityVerifiedAt         DateTime?
  /// Provider that confirmed the identity, e.g. "nvi-kps-public" or "manual".
  identityVerificationSource String?

  /// Portrait taken at registration; MinIO object key (`<tenantId>/employees/<id>/photo-<uuid>.jpg`).
  photoKey       String?
  photoUpdatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  company                Company?                @relation(fields: [companyId], references: [id])
  occupation             Occupation?             @relation(fields: [occupationId], references: [id])
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  workplace              Workplace?              @relation(fields: [workplaceId], references: [id])
  addressProvince        Province?               @relation(fields: [addressProvinceId], references: [id])
  addressDistrict        District?               @relation(fields: [addressDistrictId], references: [id])
  addressNeighborhood    Neighborhood?           @relation(fields: [addressNeighborhoodId], references: [id])
  protocols              Protocol[]
  consents               PatientConsent[]
  signatures             DocumentSignature[]
  audiometryTests        AudiometryTest[]
  ecgRecords             EcgRecord[]
  spirometryTests        SpirometryTest[]
  eyeExaminations        EyeExamination[]
  pneumoconiosisReadings PneumoconiosisReading[]
  examinations           Examination[]
  radiologyRequests      RadiologyRequest[]
  documents              Document[]
  appointments           Appointment[]

  // Uniqueness of nationalId / registrationNumber per tenant applies to ACTIVE records only
  // (partial unique indexes, see migration *_employee_partial_unique_indexes). Prisma cannot
  // express partial indexes, so plain indexes are declared here.
  @@index([tenantId, nationalId])
  @@index([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([tenantId, lastName, firstName])
  @@map("employees")
}

// ----------------------------- Reference data (global) -----------------------

/// Turkish provinces (il). `id` is the licence-plate code (1-81).
model Province {
  id                   Int                   @id
  name                 String
  districts            District[]
  employees            Employee[]
  organizationProfiles OrganizationProfile[]

  @@map("provinces")
}

model District {
  id                   Int                   @id
  provinceId           Int
  name                 String
  province             Province              @relation(fields: [provinceId], references: [id])
  neighborhoods        Neighborhood[]
  employees            Employee[]
  organizationProfiles OrganizationProfile[]

  @@index([provinceId])
  @@map("districts")
}

model Neighborhood {
  id         Int        @id
  districtId Int
  name       String
  district   District   @relation(fields: [districtId], references: [id])
  employees  Employee[]

  @@index([districtId])
  @@map("neighborhoods")
}

// ----------------------------- Medical ---------------------------------------
// NOTE: Examination and RadiologyRequest contain sensitive health data.
// Access is gated by "medical" permissions and the @MedicalData() decorator.

model Examination {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  employeeId         String            @db.Uuid
  /// Visit this clinical evaluation belongs to (set when opened from a protocol).
  protocolId         String?           @db.Uuid
  type               ExaminationType
  status             ExaminationStatus @default(SCHEDULED)
  scheduledAt        DateTime?
  performedAt        DateTime?
  physicianId        String?           @db.Uuid
  /// Clinical findings - medical data.
  findings           String?
  /// Physician conclusion - medical data.
  conclusion         String?
  fitnessDecision    FitnessDecision   @default(PENDING)
  restrictions       String?
  approvedById       String?           @db.Uuid
  approvedAt         DateTime?
  nextExaminationDue DateTime?         @db.Date
  /// Structured anamnesis (Ek-2 section A) - medical data. Shape: shared `Anamnesis`.
  anamnesis          Json?
  /// Per-system physical examination (Ek-2 section B) - medical data. Shape: shared `SystemsExam`.
  systemsExam        Json?
  /// Physician profile that signs the report (title, diploma no, signature image).
  physicianProfileId String?           @db.Uuid
  /// Approved report PDF (Document, category REPORT).
  reportDocumentId   String?           @unique @db.Uuid
  /// Optimistic concurrency token for edits, measurements and approval.
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  employee          Employee                 @relation(fields: [employeeId], references: [id])
  protocol          Protocol?                @relation(fields: [protocolId], references: [id])
  physician         User?                    @relation("ExaminationPhysician", fields: [physicianId], references: [id])
  approvedBy        User?                    @relation("ExaminationApprover", fields: [approvedById], references: [id])
  physicianProfile  Physician?               @relation("ExaminationPhysicianProfile", fields: [physicianProfileId], references: [id])
  reportDocument    Document?                @relation("ExaminationReport", fields: [reportDocumentId], references: [id])
  radiologyRequests RadiologyRequest[]
  documents         Document[]
  appointments      Appointment[]
  measurements      ExaminationMeasurement[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, protocolId])
  @@map("examinations")
}

enum EcgRhythm {
  SINUS
  SINUS_ARRHYTHMIA
  SINUS_BRADYCARDIA
  SINUS_TACHYCARDIA
  ATRIAL_FIBRILLATION
  ATRIAL_FLUTTER
  SUPRAVENTRICULAR_TACHYCARDIA
  PACED
  OTHER
}

enum EcgInterpretation {
  NORMAL
  BORDERLINE
  ABNORMAL
}

/// Resting 12-lead ECG record (EKG). Intervals in ms, axis in degrees; findings are codes from the
/// shared ECG_FINDINGS catalogue. The device printout is a Document (category ECG_TRACE).
model EcgRecord {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  employeeId     String            @db.Uuid
  protocolId     String?           @db.Uuid
  performedAt    DateTime          @default(now())
  performedById  String?           @db.Uuid
  deviceName     String?
  heartRate      Int?
  rhythm         EcgRhythm?
  prInterval     Int?
  qrsDuration    Int?
  qtInterval     Int?
  /// As reported by the device; when null the API derives Bazett QTc.
  qtcInterval    Int?
  axis           Int?
  findings       String[]          @default([])
  interpretation EcgInterpretation @default(NORMAL)
  /// Physician comment - medical data.
  comment        String?
  documentId     String?           @unique @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])
  protocol    Protocol? @relation(fields: [protocolId], references: [id])
  performedBy User?     @relation("EcgPerformer", fields: [performedById], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])

  @@index([tenantId, employeeId, performedAt])
  @@index([tenantId, performedAt])
  @@map("ecg_records")
}

enum SpirometryPattern {
  NORMAL
  OBSTRUCTIVE
  RESTRICTIVE
  MIXED
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
}

/// Spirometry test (Solunum fonksiyon testi). Volumes in litres, flows in L/s, ratio in %.
/// Predicted values are stored when the device reports them; otherwise derived (ECSC 1993).
model SpirometryTest {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  employeeId    String             @db.Uuid
  protocolId    String?            @db.Uuid
  performedAt   DateTime           @default(now())
  performedById String?            @db.Uuid
  deviceName    String?
  heightCm      Int?
  weightKg      Decimal?           @db.Decimal(5, 1)
  smokingStatus SmokingStatus?
  fvc           Decimal?           @db.Decimal(4, 2)
  fev1          Decimal?           @db.Decimal(4, 2)
  /// Device-reported FEV1/FVC %; null → derived from FEV1 and FVC.
  ratio         Decimal?           @db.Decimal(4, 1)
  pef           Decimal?           @db.Decimal(4, 2)
  fef2575       Decimal?           @db.Decimal(4, 2)
  fvcPredicted  Decimal?           @db.Decimal(4, 2)
  fev1Predicted Decimal?           @db.Decimal(4, 2)
  /// Post-bronchodilator values when a reversibility test was done.
  postFvc       Decimal?           @db.Decimal(4, 2)
  postFev1      Decimal?           @db.Decimal(4, 2)
  /// Acceptability / repeatability grade reported by the device (A–F).
  qualityGrade  String?
  /// Reference test for the longitudinal FEV1 decline.
  isBaseline    Boolean            @default(false)
  pattern       SpirometryPattern?
  /// Physician comment - medical data.
  comment       String?
  documentId    String?            @unique @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])
  protocol    Protocol? @relation(fields: [protocolId], references: [id])
  performedBy User?     @relation("SpirometryPerformer", fields: [performedById], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])

  @@index([tenantId, employeeId, performedAt])
  @@index([tenantId, performedAt])
  @@map("spirometry_tests")
}

enum ColorVisionResult {
  NORMAL
  DEFICIENT
  NOT_TESTED
}

enum VisualFieldResult {
  NORMAL
  ABNORMAL
  NOT_TESTED
}

enum EyeRecommendation {
  NONE
  GLASSES
  REFERRAL
}

/// Eye examination (Göz). Distance acuity as decimal (1.0 = 6/6), near acuity as Jaeger number,
/// colour vision as Ishihara plates read / shown.
model EyeExamination {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  employeeId        String            @db.Uuid
  protocolId        String?           @db.Uuid
  performedAt       DateTime          @default(now())
  performedById     String?           @db.Uuid
  usesGlasses       Boolean           @default(false)
  usesContactLenses Boolean           @default(false)
  farRight          Decimal?          @db.Decimal(3, 2)
  farLeft           Decimal?          @db.Decimal(3, 2)
  farRightCorrected Decimal?          @db.Decimal(3, 2)
  farLeftCorrected  Decimal?          @db.Decimal(3, 2)
  nearRight         Int?
  nearLeft          Int?
  ishiharaCorrect   Int?
  ishiharaTotal     Int?
  /// Given directly when plates were not counted (e.g. another test method).
  colorVision       ColorVisionResult @default(NOT_TESTED)
  visualField       VisualFieldResult @default(NOT_TESTED)
  /// External eye / other findings - medical data.
  findings          String?
  recommendation    EyeRecommendation @default(NONE)
  comment           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])
  protocol    Protocol? @relation(fields: [protocolId], references: [id])
  performedBy User?     @relation("EyePerformer", fields: [performedById], references: [id])

  @@index([tenantId, employeeId, performedAt])
  @@index([tenantId, performedAt])
  @@map("eye_examinations")
}

enum PneumoconiosisResult {
  NEGATIVE
  BORDERLINE
  POSITIVE
}

/// ILO 2011 reading of a chest radiograph (Pnömokonyoz). Several readings may exist for one film
/// (reader A / B). Codes follow the shared PROFUSIONS / OPACITY_SHAPES / ILO_SYMBOLS catalogues.
model PneumoconiosisReading {
  id                       String               @id @default(uuid()) @db.Uuid
  tenantId                 String               @db.Uuid
  employeeId               String               @db.Uuid
  protocolId               String?              @db.Uuid
  radiologyRequestId       String?              @db.Uuid
  readAt                   DateTime             @default(now())
  readerId                 String?              @db.Uuid
  /// e.g. "A okuyucu", "B okuyucu", "NIOSH B reader".
  readerRole               String?
  filmDate                 DateTime?            @db.Date
  filmQuality              Int?
  qualityComment           String?
  profusion                String?
  shapePrimary             String?
  shapeSecondary           String?
  zones                    String[]             @default([])
  largeOpacity             String               @default("0")
  pleuralPlaques           Boolean              @default(false)
  plaqueCalcification      Boolean              @default(false)
  diffuseThickening        Boolean              @default(false)
  costophrenicObliteration String[]             @default([])
  symbols                  String[]             @default([])
  result                   PneumoconiosisResult @default(NEGATIVE)
  /// Reader comment - medical data.
  comment                  String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  protocol         Protocol?         @relation(fields: [protocolId], references: [id])
  radiologyRequest RadiologyRequest? @relation(fields: [radiologyRequestId], references: [id])
  reader           User?             @relation("PneumoReader", fields: [readerId], references: [id])

  @@index([tenantId, employeeId, readAt])
  @@index([tenantId, readAt])
  @@map("pneumoconiosis_readings")
}

/// Pure-tone audiometry test (Odyometri). Thresholds are JSON maps `{ "500": 10, … }` in dB HL;
/// the four-frequency averages are stored for listing/filtering, everything else is derived.
model AudiometryTest {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  employeeId    String    @db.Uuid
  protocolId    String?   @db.Uuid
  performedAt   DateTime  @default(now())
  performedById String?   @db.Uuid
  deviceName    String?
  /// Reference test for later threshold-shift comparisons.
  isBaseline    Boolean   @default(false)
  /// Hours without noise exposure before the test (≥14 h recommended for a baseline).
  quietHours    Int?
  airRight      Json
  airLeft       Json
  boneRight     Json?
  boneLeft      Json?
  ptaRight      Decimal?  @db.Decimal(5, 1)
  ptaLeft       Decimal?  @db.Decimal(5, 1)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])
  protocol    Protocol? @relation(fields: [protocolId], references: [id])
  performedBy User?     @relation("AudiometryPerformer", fields: [performedById], references: [id])

  @@index([tenantId, employeeId, performedAt])
  @@index([tenantId, performedAt])
  @@map("audiometry_tests")
}

/// Structured value recorded on an examination (boy, kilo, tansiyon, FEV1 …). Keys come from the
/// shared MEASUREMENT_DEFINITIONS catalogue; Muayene Karşılaştırma compares them across visits.
model ExaminationMeasurement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  examinationId String   @db.Uuid
  key           String
  value         Decimal  @db.Decimal(10, 2)
  note          String?
  recordedAt    DateTime @default(now())
  recordedById  String?  @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  recordedBy  User?       @relation("MeasurementRecorder", fields: [recordedById], references: [id])

  @@unique([examinationId, key])
  @@index([tenantId, examinationId])
  @@map("examination_measurements")
}

/// Doktor Tanımları: physicians who examine, report and sign. Optionally linked to a login user.
model Physician {
  id                        String          @id @default(uuid()) @db.Uuid
  tenantId                  String          @db.Uuid
  /// Login account of the physician (one account ↔ one physician).
  userId                    String?         @unique @db.Uuid
  /// Academic/professional title shown before the name (Dr., Uzm. Dr., Doç. Dr. …).
  title                     String?
  firstName                 String
  lastName                  String
  /// Branch/specialty, free text chosen from a suggested list (İşyeri Hekimi, Radyoloji …).
  specialty                 String?
  diplomaNumber             String?
  /// Diploma tescil no (Sağlık Bakanlığı).
  diplomaRegistrationNumber String?
  /// İşyeri hekimliği belgesi no.
  certificateNumber         String?
  phone                     String?
  email                     String?
  /// Signature image printed on reports (PNG in MinIO).
  signatureKey              String?
  signatureUpdatedAt        DateTime?
  status                    PhysicianStatus @default(ACTIVE)
  notes                     String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  deletedAt                 DateTime?

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  signedExaminations Examination[] @relation("ExaminationPhysicianProfile")
  user               User?         @relation(fields: [userId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, lastName, firstName])
  @@map("physicians")
}

/// Tetkik Tanımları: the OSGB's catalogue of tests/services with list prices.
model TestDefinition {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  /// Short unique code per tenant (e.g. LAB-HGB, RAD-PA).
  code            String
  name            String
  category        TestCategory
  /// List price without VAT, TRY.
  unitPrice       Decimal      @default(0) @db.Decimal(10, 2)
  /// VAT percentage (0, 10, 20).
  vatRate         Int          @default(20)
  /// Typical duration for scheduling, minutes.
  durationMinutes Int?
  /// LAB only: sample type (kan, idrar …).
  sampleType      String?
  /// LAB only: reference range shown next to results.
  referenceRange  String?
  unit            String?
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  packageItems TestPackageItem[]

  @@index([tenantId, category, isActive])
  @@index([tenantId, code])
  @@map("test_definitions")
}

/// Tetkik Paketleri: a named bundle of catalogue tests (e.g. "İşe Giriş Standart").
model TestPackage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  code        String
  name        String
  description String?
  /// Package price without VAT; null = sum of the items' list prices.
  price       Decimal?  @db.Decimal(10, 2)
  vatRate     Int       @default(20)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  items  TestPackageItem[]

  @@index([tenantId, isActive])
  @@index([tenantId, code])
  @@map("test_packages")
}

model TestPackageItem {
  id         String @id @default(uuid()) @db.Uuid
  packageId  String @db.Uuid
  testId     String @db.Uuid
  quantity   Int    @default(1)
  orderIndex Int    @default(0)

  package TestPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test    TestDefinition @relation(fields: [testId], references: [id])

  @@unique([packageId, testId])
  @@index([testId])
  @@map("test_package_items")
}

/// Meslek Tanımları: occupations assigned to patients (drives periodic-exam and hazard rules later).
model Occupation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  /// Optional classification code (ISCO-08 / SGK meslek kodu), unique per tenant when set.
  code        String?
  name        String
  /// Turkish-aware lower-cased name (İ→i, I→ı) for duplicate checks; Postgres lower() cannot fold these.
  nameKey     String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@index([tenantId, isActive, name])
  @@index([tenantId, nameKey])
  @@map("occupations")
}

/// KVKK consent text. Versions are immutable (legal proof); a new version supersedes the old one.
model ConsentTemplate {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  type          ConsentType
  version       Int
  title         String
  /// Plain text / Markdown shown to the patient and printed on the signed form.
  body          String
  /// Version in force from this date; the newest active version per type is the one offered.
  effectiveFrom DateTime    @default(now())
  isActive      Boolean     @default(true)
  createdById   String?     @db.Uuid
  createdAt     DateTime    @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  consents PatientConsent[]

  @@unique([tenantId, type, version])
  @@index([tenantId, type, isActive])
  @@map("consent_templates")
}

/// A patient's consent (or acknowledgement) to a specific template version.
model PatientConsent {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  employeeId     String        @db.Uuid
  templateId     String        @db.Uuid
  status         ConsentStatus @default(GIVEN)
  method         ConsentMethod
  givenAt        DateTime      @default(now())
  withdrawnAt    DateTime?
  withdrawReason String?
  collectedById  String?       @db.Uuid
  /// Signed form (Belge İmza) once available.
  documentId     String?       @db.Uuid
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  employee    Employee           @relation(fields: [employeeId], references: [id])
  template    ConsentTemplate    @relation(fields: [templateId], references: [id])
  collectedBy User?              @relation("ConsentCollector", fields: [collectedById], references: [id])
  signature   DocumentSignature?

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("patient_consents")
}

/// Belge İmza: proof record for a PDF the patient signed on the signature pad (or a stamped upload).
model DocumentSignature {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  documentId    String   @unique @db.Uuid
  employeeId    String   @db.Uuid
  /// Set when the signed form is a KVKK consent text.
  consentId     String?  @unique @db.Uuid
  title         String
  signerName    String
  signedAt      DateTime @default(now())
  collectedById String?  @db.Uuid
  /// Trimmed PNG of the raw signature, kept separately from the PDF.
  signatureKey  String
  /// SHA-256 of the stored PDF bytes; `verify` re-hashes the object to detect tampering.
  sha256        String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  document    Document        @relation(fields: [documentId], references: [id])
  employee    Employee        @relation(fields: [employeeId], references: [id])
  consent     PatientConsent? @relation(fields: [consentId], references: [id])
  collectedBy User?           @relation("SignatureCollector", fields: [collectedById], references: [id])

  @@index([tenantId, employeeId])
  @@index([tenantId, signedAt])
  @@map("document_signatures")
}

/// Kurum Bilgileri: the OSGB's own legal/contact identity (one row per tenant), printed on reports.
model OrganizationProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @unique @db.Uuid
  /// Registered legal title (ticari ünvan); Tenant.name stays the short display name.
  legalName             String?
  taxOffice             String?
  taxNumber             String?
  sgkRegistrationNumber String?
  /// Bakanlık OSGB yetki belgesi numarası ve tarihi.
  authorizationNumber   String?
  authorizationDate     DateTime? @db.Date
  responsibleManager    String?
  phone                 String?
  fax                   String?
  email                 String?
  website               String?
  addressProvinceId     Int?
  addressDistrictId     Int?
  addressLine           String?
  /// Free text printed at the bottom of reports (e.g. bank details, disclaimers).
  reportFooter          String?
  /// DICOM AE Title of this tenant's radiology modality; used to scope MWL answers.
  radiologyStationAet   String?
  logoKey               String?
  logoUpdatedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  addressProvince Province? @relation(fields: [addressProvinceId], references: [id])
  addressDistrict District? @relation(fields: [addressDistrictId], references: [id])

  @@map("organization_profiles")
}

/// A visit (Protokol): one patient, one reason, a set of ordered tests. The backbone the doctor
/// modules attach to. Numbered per tenant and year (e.g. 2026-000123) via ProtocolCounter.
model Protocol {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  /// Human-readable, unique per tenant: `<year>-<6 digit sequence>`.
  protocolNumber String
  year           Int
  sequence       Int
  employeeId     String          @db.Uuid
  /// Workplace at the time of the visit (copied from the employee, editable).
  companyId      String?         @db.Uuid
  type           ExaminationType
  status         ProtocolStatus  @default(OPEN)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  openedById     String          @db.Uuid
  closedById     String?         @db.Uuid
  /// Free text reason / remarks (not medical findings).
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  employee               Employee                @relation(fields: [employeeId], references: [id])
  company                Company?                @relation(fields: [companyId], references: [id])
  openedBy               User                    @relation("ProtocolOpener", fields: [openedById], references: [id])
  closedBy               User?                   @relation("ProtocolCloser", fields: [closedById], references: [id])
  operationRecords       OperationRecord[]
  items                  ProtocolItem[]
  examinations           Examination[]
  audiometryTests        AudiometryTest[]
  ecgRecords             EcgRecord[]
  spirometryTests        SpirometryTest[]
  eyeExaminations        EyeExamination[]
  pneumoconiosisReadings PneumoconiosisReading[]

  @@unique([tenantId, protocolNumber])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@index([tenantId, openedAt])
  @@map("protocols")
}

/// One ordered test / output on a protocol.
model ProtocolItem {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  protocolId  String             @db.Uuid
  type        ProtocolItemType
  status      ProtocolItemStatus @default(PENDING)
  /// Short outcome note entered when the item is completed (not the medical report itself).
  note        String?
  completedAt DateTime?
  orderIndex  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  protocol Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@unique([protocolId, type])
  @@index([tenantId, type, status])
  @@map("protocol_items")
}

/// Per-tenant, per-year sequence for protocol numbers (row updated inside the create transaction).
model ProtocolCounter {
  tenantId String @db.Uuid
  year     Int
  last     Int    @default(0)

  @@id([tenantId, year])
  @@map("protocol_counters")
}

enum RadiologyWorklistStatus {
  NOT_CONFIGURED
  PENDING
  PUBLISHED
  FAILED
  REMOVED
}

/// Reference to a DICOM study stored in Orthanc. No pixel data is stored here.
model RadiologyRequest {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String                  @db.Uuid
  employeeId       String                  @db.Uuid
  examinationId    String?                 @db.Uuid
  modality         RadiologyModality
  status           RadiologyRequestStatus  @default(REQUESTED)
  bodyPart         String?
  clinicalInfo     String?
  /// DICOM Accession Number: generated by the server and used for deterministic order matching.
  accessionNumber  String?                 @unique
  /// Orthanc Worklists plugin resource and synchronization state.
  worklistId       String?
  worklistStatus   RadiologyWorklistStatus @default(NOT_CONFIGURED)
  worklistSyncedAt DateTime?
  /// Bounded background retry state for temporary PACS/MWL failures.
  worklistAttemptCount Int       @default(0)
  worklistNextAttemptAt DateTime?
  worklistLastError    String?
  /// Orthanc internal patient identifier.
  orthancPatientId String?
  /// Orthanc internal study identifier.
  orthancStudyId   String?
  /// DICOM StudyInstanceUID (0020,000D) - used to open the study in OHIF.
  studyInstanceUid String?                 @unique
  requestedAt      DateTime                @default(now())
  completedAt      DateTime?
  /// Radiology report - medical data.
  reportText       String?
  reportedById     String?                 @db.Uuid
  reportedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  employee               Employee                @relation(fields: [employeeId], references: [id])
  examination            Examination?            @relation(fields: [examinationId], references: [id])
  appointments           Appointment[]
  pneumoconiosisReadings PneumoconiosisReading[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, studyInstanceUid])
  @@index([tenantId, worklistStatus, worklistNextAttemptAt])
  @@map("radiology_requests")
}

// ----------------------------- Files & scheduling ----------------------------

/// Metadata for a file stored in MinIO (PDFs, certificates, scans, attachments).
model Document {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  category      DocumentCategory @default(OTHER)
  fileName      String
  mimeType      String
  sizeBytes     Int
  bucket        String
  /// Object key inside the bucket; always prefixed with the tenant id.
  objectKey     String           @unique
  checksum      String?
  /// JPEG preview for image uploads; original document remains authoritative.
  thumbnailKey  String?
  /// True when the document contains health data (stricter access rules).
  isMedical     Boolean          @default(false)
  employeeId    String?          @db.Uuid
  companyId     String?          @db.Uuid
  examinationId String?          @db.Uuid
  /// Calendar expiry date for document/contract tracking; null means unspecified.
  expiresAt     DateTime?         @db.Date
  uploadedById  String?          @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  employee          Employee?          @relation(fields: [employeeId], references: [id])
  company           Company?           @relation(fields: [companyId], references: [id])
  examination       Examination?       @relation(fields: [examinationId], references: [id])
  uploadedBy        User?              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  signature         DocumentSignature?
  ecgRecord         EcgRecord?
  spirometryTest    SpirometryTest?
  examinationReport Examination?       @relation("ExaminationReport")

  @@index([tenantId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, employeeId])
  @@index([tenantId, category])
  @@index([tenantId, deletedAt])
  @@map("documents")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  type               AppointmentType   @default(EXAMINATION)
  status             AppointmentStatus @default(SCHEDULED)
  title              String
  startsAt           DateTime
  endsAt             DateTime
  location           String?
  notes              String?
  employeeId         String?           @db.Uuid
  companyId          String?           @db.Uuid
  examinationId      String?           @db.Uuid
  radiologyRequestId String?           @db.Uuid
  createdById        String?           @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  employee         Employee?         @relation(fields: [employeeId], references: [id])
  company          Company?          @relation(fields: [companyId], references: [id])
  examination      Examination?      @relation(fields: [examinationId], references: [id])
  radiologyRequest RadiologyRequest? @relation(fields: [radiologyRequestId], references: [id])
  createdBy        User?             @relation("AppointmentCreator", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, startsAt])
  @@map("appointments")
}

// ----------------------------- Audit -----------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  /// Correlation id of the HTTP request (X-Request-Id) - joins audit rows with application logs.
  requestId  String?
  /// Request/outcome details for automatically captured entries: method, path, statusCode, durationMs, outcome, errorCode.
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([requestId])
  @@map("audit_logs")
}

/// Persistent in-app notification. A null recipient is visible to every active user in the tenant.
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  recipientUserId String?   @db.Uuid
  /// BullMQ job id or another producer key; makes delivery idempotent.
  sourceKey       String?   @unique
  template        String
  title           String
  body            String
  payload         Json?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User?  @relation(fields: [recipientUserId], references: [id])

  @@index([tenantId, recipientUserId, readAt, createdAt])
  @@map("notifications")
}

/// Small operational registers share lifecycle and versioning; payloads are validated per kind.
model OperationRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  kind        String
  title       String
  date        DateTime @db.Date
  status      String
  fields      Json
  amountCents Int?
  protocolId  String?  @db.Uuid
  version     Int      @default(1)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  protocol    Protocol? @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  createdBy   User @relation(fields: [createdById], references: [id])

  @@index([tenantId, kind, date])
  @@unique([tenantId, kind, protocolId])
  @@map("operation_records")
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  userStamp DateTime
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  @@index([tenantId, userId])
  @@map("password_reset_tokens")
}
